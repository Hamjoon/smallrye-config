/tools/maven
/tools/maven.zip
# ignore eclipse files
.project
.classpath
.settings
.metadata
.checkstyle
# ignore m2e annotation processing files
.factorypath
# ignore IDEA files
*.iml
*.ipr
*.iws
.idea
# ignore NetBeans files
nbactions.xml
nb-configuration.xml
catalog.xml
#
maven-ant-tasks.jar
test-output
transaction.log
# vim files
*.swp
/.gitk-tmp.*
atlassian-ide-plugin.xml
# temp files
*~
# maven versions plugin
pom.xml.versionsBackup
# hprof dumps
/*.hprof
# ignore 'randomly' strewn around logs
server.log
# ignore java crashes
hs_err_pid*.log
# H2 databases produced by tests
*.h2.db
# JBoss transaction generated files
PutObjectStoreDirHere
# ignore mvn-rpmbuild repo
/.m2
# ignore eap repo
local-repo-eap

#These keep hanging around
arquillian/*/server.log*
client/shade/dependency-reduced-pom.xml

#OS X stuff
.DS_Store

# Zanata files
**/.zanata-cache/

# Jenv
.java-version

# MkDocs
site

# formatter cache directories
.cache

# Claude/Codex working documents (not published)
.local/

# Experiment folders: publish only the configuration, summary tables, population
# definitions and kept generated test sources. Raw records, build logs, tool state
# and scratch stay local and go to the Drive archive (survival archive).
experiments/**
!experiments/*/
!experiments/*/experiment.yaml
!experiments/*/README.md
!experiments/*/results/
!experiments/*/results/*.csv
!experiments/*/results/*.md
