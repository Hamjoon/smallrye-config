package io.smallrye.config;

import static org.junit.Assert.*;

import java.util.*;

import org.junit.Before;
import org.junit.Test;

/**
 * JUnit‑4 test suite for {@link ConfigMappings}.
 *
 * <p>This file was generated by analysing the source of {@code ConfigMappings} and
 * enumerating all public methods (including the public static nested class
 * {@code ConfigClassWithPrefix}). For each method a basic functional test is
 * provided together with additional tests that cover edge‑case and exception
 * scenarios identified from the implementation.</p>
 *
 * <p>Only APIs that appear in the supplied source code or in the allowed
 * dependency signatures are used – no mocking frameworks are employed.</p>
 */
public class ConfigMappingsTest {

    /* ----------------------------------------------------------------------
     *  Public methods of ConfigMappings (including the nested static class)
     * ---------------------------------------------------------------------- */
    // ConfigMappings
    //   public static void registerConfigMappings(SmallRyeConfig, Set<ConfigClassWithPrefix>) throws ConfigValidationException
    //   public static void registerConfigProperties(SmallRyeConfig, Set<ConfigClassWithPrefix>) throws ConfigValidationException
    //   public static Map<String, Property> getProperties(ConfigClassWithPrefix)
    //   @Deprecated public static Set<String> mappedProperties(ConfigClassWithPrefix, Set<String>)
    //   static String prefix(String, String)
    //   static String getPrefix(Class<?>)
    //
    // ConfigMappings.ConfigClassWithPrefix
    //   public ConfigClassWithPrefix(Class<?>, String)
    //   public Class<?> getKlass()
    //   public String getPrefix()
    //   public boolean equals(Object)
    //   public int hashCode()
    //   public static ConfigClassWithPrefix configClassWithPrefix(Class<?>, String)
    //   public static ConfigClassWithPrefix configClassWithPrefix(Class<?>)

    /* ----------------------------------------------------------------------
     *  Helper objects used by many tests
     * ---------------------------------------------------------------------- */
    private SmallRyeConfig config;

    @Before
    public void setUp() {
        // SmallRyeConfig has a public no‑arg constructor (not shown in the stub but
        // required for the tests). We use it directly – no mocking.
        config = new SmallRyeConfig();
    }

    /* ----------------------------------------------------------------------
     *  Tests for ConfigMappings.prefix(...)
     * ---------------------------------------------------------------------- */
    @Test
    public void testPrefixWhenPrefixEmpty() {
        assertEquals("path", ConfigMappings.prefix("", "path"));
    }

    @Test
    public void testPrefixWhenPathEmpty() {
        assertEquals("my.prefix", ConfigMappings.prefix("my.prefix", ""));
    }

    @Test
    public void testPrefixWhenPathStartsWithBracket() {
        assertEquals("my.prefix[0].name", ConfigMappings.prefix("my.prefix", "[0].name"));
    }

    @Test
    public void testPrefixNormalConcatenation() {
        assertEquals("my.prefix.sub", ConfigMappings.prefix("my.prefix", "sub"));
    }

    /* ----------------------------------------------------------------------
     *  Tests for ConfigMappings.getPrefix(...)
     * ---------------------------------------------------------------------- */
    @Test
    public void testGetPrefixOnClassWithoutAnnotation() {
        assertEquals("", ConfigMappings.getPrefix(String.class));
    }

    @Test
    public void testGetPrefixOnAnnotatedClass() {
        // Define a tiny @ConfigMapping annotated class locally
        @ConfigMapping(prefix = "test.prefix")
        class DummyMapping {}

        assertEquals("test.prefix", ConfigMappings.getPrefix(DummyMapping.class));
    }

    /* ----------------------------------------------------------------------
     *  Tests for ConfigClassWithPrefix construction & basic contract
     * ---------------------------------------------------------------------- */
    @Test
    public void testConfigClassWithPrefixConstructorAndAccessors() {
        ConfigMappings.ConfigClassWithPrefix c = new ConfigMappings.ConfigClassWithPrefix(Integer.class, "int");
        assertEquals(Integer.class, c.getKlass());
        assertEquals("int", c.getPrefix());
    }

    @Test
    public void testConfigClassWithPrefixFactoryMethods() {
        ConfigMappings.ConfigClassWithPrefix c1 = ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(Long.class, "lng");
        ConfigMappings.ConfigClassWithPrefix c2 = ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(Long.class);
        assertEquals(Long.class, c1.getKlass());
        assertEquals("lng", c1.getPrefix());

        // The second factory should use the annotation to derive the prefix.
        // Since Long.class has no @ConfigMapping, the prefix must be empty.
        assertEquals(Long.class, c2.getKlass());
        assertEquals("", c2.getPrefix());
    }

    @Test
    public void testConfigClassWithPrefixEqualsAndHashCode() {
        ConfigMappings.ConfigClassWithPrefix a = new ConfigMappings.ConfigClassWithPrefix(String.class, "p");
        ConfigMappings.ConfigClassWithPrefix b = new ConfigMappings.ConfigClassWithPrefix(String.class, "p");
        ConfigMappings.ConfigClassWithPrefix c = new ConfigMappings.ConfigClassWithPrefix(String.class, "different");

        assertTrue(a.equals(b));
        assertEquals(a.hashCode(), b.hashCode());

        assertFalse(a.equals(c));
        assertNotEquals(a.hashCode(), c.hashCode());

        // Equality must be false for different class objects
        assertFalse(a.equals(null));
        assertFalse(a.equals("someString"));
    }

    /* ----------------------------------------------------------------------
     *  Tests for ConfigMappings.getProperties(...)
     * ---------------------------------------------------------------------- */
    @Test
    public void testGetPropertiesReturnsEmptyMapForUnknownClass() {
        // Use a class that is not a ConfigMapping – the loader will return null
        // and the method will simply return an empty map.
        ConfigMappings.ConfigClassWithPrefix wrapper =
                ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(Object.class, "obj");
        Map<String, ConfigMappingInterface.Property> props = ConfigMappings.getProperties(wrapper);
        assertNotNull(props);
        assertTrue(props.isEmpty());
    }

    /* ----------------------------------------------------------------------
     *  Tests for ConfigMappings.mappedProperties(...) – deprecated but still usable
     * ---------------------------------------------------------------------- */
    @Test
    public void testMappedPropertiesFiltersCorrectly() {
        // Set up a dummy ConfigClassWithPrefix that has no mapping names.
        ConfigMappings.ConfigClassWithPrefix wrapper =
                ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(Object.class, "");

        Set<String> input = new HashSet<>(Arrays.asList("a", "b"));
        Set<String> result = ConfigMappings.mappedProperties(wrapper, input);
        // With no mapping information, the result must be empty.
        assertTrue(result.isEmpty());
    }

    /* ----------------------------------------------------------------------
     *  Tests for registerConfigMappings and registerConfigProperties
     *
     *  These methods delegate to the private mapConfiguration(...).  We verify
     *  that they behave correctly when the supplied set is empty (no
     *  interaction with the builder) and when it contains a class – the
     *  builder must receive the mapping and the config must contain the
     *  resulting mappings.
     * ---------------------------------------------------------------------- */
    @Test
    public void testRegisterConfigMappingsWithEmptySetDoesNothing() throws Exception {
        Set<ConfigMappings.ConfigClassWithPrefix> empty = Collections.emptySet();

        // The call should simply return without throwing.
        ConfigMappings.registerConfigMappings(config, empty);
        // No mappings should have been added.
        assertTrue(config.getMappings().isEmpty());
    }

    @Test
    public void testRegisterConfigPropertiesWithEmptySetDoesNothing() throws Exception {
        Set<ConfigMappings.ConfigClassWithPrefix> empty = Collections.emptySet();
        ConfigMappings.registerConfigProperties(config, empty);
        assertTrue(config.getMappings().isEmpty());
    }

    @Test
    public void testRegisterConfigMappingsAddsMapping() throws Exception {
        // Create a dummy @ConfigMapping class to be registered.
        @ConfigMapping(prefix = "dummy")
        class DummyConfig {}

        ConfigMappings.ConfigClassWithPrefix wrapper =
                ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(DummyConfig.class);

        Set<ConfigMappings.ConfigClassWithPrefix> set = new HashSet<>();
        set.add(wrapper);

        ConfigMappings.registerConfigMappings(config, set);

        // After registration the config should contain the mapping for DummyConfig.
        assertTrue(config.getMappings().containsKey(DummyConfig.class));
        // The prefix stored inside the mapping builder is the one we declared.
        // SmallRyeConfig does not expose the prefix directly, but we can verify
        // that the mapping exists.
    }

    @Test
    public void testRegisterConfigPropertiesAddsMappingAndDisablesValidateUnknown() throws Exception {
        @ConfigMapping(prefix = "prop")
        class PropConfig {}

        ConfigMappings.ConfigClassWithPrefix wrapper =
                ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(PropConfig.class);

        Set<ConfigMappings.ConfigClassWithPrefix> set = new HashSet<>();
        set.add(wrapper);

        ConfigMappings.registerConfigProperties(config, set);

        assertTrue(config.getMappings().containsKey(PropConfig.class));
        // The builder used for properties is configured with
        // withValidateUnknown(false); we verify that the config's
        // validator flag reflects this (the API does not expose it directly,
        // so we only assert that registration succeeded without exception).
    }

    /* ----------------------------------------------------------------------
     *  Edge‑case / exception tests
     * ---------------------------------------------------------------------- */
    @Test(expected = ConfigValidationException.class)
    public void testRegisterConfigMappingsThrowsWhenMappingFails() throws Exception {
        // Simulate a failing mapping by providing a class that the builder
        // cannot handle – for the purpose of this test we rely on the fact
        // that SmallRyeConfigBuilder.withMapping will eventually throw a
        // ConfigValidationException for a null prefix (illegal state).
        class BadMapping {}

        ConfigMappings.ConfigClassWithPrefix wrapper =
                ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(BadMapping.class, null);

        Set<ConfigMappings.ConfigClassWithPrefix> set = Collections.singleton(wrapper);
        ConfigMappings.registerConfigMappings(config, set);
    }

    @Test(expected = ConfigValidationException.class)
    public void testRegisterConfigPropertiesThrowsWhenMappingFails() throws Exception {
        class BadProp {}

        ConfigMappings.ConfigClassWithPrefix wrapper =
                ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(BadProp.class, null);

        Set<ConfigMappings.ConfigClassWithPrefix> set = Collections.singleton(wrapper);
        ConfigMappings.registerConfigProperties(config, set);
    }

    @Test
    public void testPrefixHandlesNullArgumentsGracefully() {
        // The implementation does not guard against nulls, so we expect a
        // NullPointerException for either argument being null.
        try {
            ConfigMappings.prefix(null, "path");
            fail("Expected NullPointerException when prefix is null");
        } catch (NullPointerException ignored) {}

        try {
            ConfigMappings.prefix("pre", null);
            fail("Expected NullPointerException when path is null");
        } catch (NullPointerException ignored) {}
    }

    @Test
    public void testGetPrefixHandlesNullClass() {
        try {
            ConfigMappings.getPrefix(null);
            fail("Expected NullPointerException for null class");
        } catch (NullPointerException ignored) {}
    }

    @Test
    public void testConfigClassWithPrefixFactoryNullArguments() {
        try {
            ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(null, "p");
            fail("Expected NullPointerException for null class argument");
        } catch (NullPointerException ignored) {}

        try {
            ConfigMappings.ConfigClassWithPrefix.configClassWithPrefix(String.class, null);
            fail("Expected NullPointerException for null prefix argument");
        } catch (NullPointerException ignored) {}
    }
}
