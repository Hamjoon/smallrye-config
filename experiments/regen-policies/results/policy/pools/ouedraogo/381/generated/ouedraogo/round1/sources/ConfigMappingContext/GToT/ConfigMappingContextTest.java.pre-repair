package io.smallrye.config;

import static org.junit.Assert.*;

import java.lang.reflect.InvocationTargetException;
import java.util.*;

import org.eclipse.microprofile.config.spi.Converter;
import org.junit.Before;
import org.junit.Test;

/**
 * Comprehensive JUnit‑4 test suite for {@link ConfigMappingContext}.
 *
 * <p>The tests cover:
 * <ul>
 *   <li>All public methods of {@code ConfigMappingContext}</li>
 *   <li>All public methods of the inner {@code ObjectCreator}</li>
 *   <li>Edge‑case handling (null arguments, empty strings, error paths)</li>
 *   <li>Exception handling inside the private {@code getConverterInstance}</li>
 * </ul>
 *
 * <p>Only the public API of {@code SmallRyeConfig}, {@code MappingBuilder},
 * {@code ConfigClass} and related types is used – no mocking frameworks are
 * employed, as required by the specification.
 */
public class ConfigMappingContextTest {

    private SmallRyeConfig config;
    private MappingBuilder mappingBuilder;
    private ConfigMappingContext context;

    /** Simple configuration interface used for mapping tests. */
    public interface DummyMapping {
        // no methods – just a marker interface
    }

    /** A converter that can be instantiated normally. */
    public static class SimpleStringConverter implements Converter<String> {
        public SimpleStringConverter() {}
        @Override
        public String convert(String value) {
            return value;
        }
    }

    /** A converter whose constructor throws a checked exception. */
    public static class BadConstructorConverter implements Converter<String> {
        public BadConstructorConverter() throws Exception {
            throw new Exception("construction failed");
        }
        @Override
        public String convert(String value) {
            return value;
        }
    }

    /** A converter with no public no‑arg constructor. */
    public static class NoDefaultCtorConverter implements Converter<String> {
        private NoDefaultCtorConverter() {}
        @Override
        public String convert(String value) {
            return value;
        }
    }

    @Before
    public void setUp() {
        // Initialise a bare‑bones SmallRyeConfig.  The default constructor reads
        // system properties, which we can control in the tests.
        config = new SmallRyeConfig();

        // Build an empty MappingBuilder – the constructor of ConfigMappingContext
        // must handle the “no mappings” case gracefully.
        mappingBuilder = new MappingBuilder();

        // Create the context under test.
        context = new ConfigMappingContext(config, mappingBuilder);
    }

    /* -------------------------------------------------------------
     *  Tests for the public API of ConfigMappingContext
     * ------------------------------------------------------------- */

    @Test
    public void testConstructorCreatesEmptyMappings() {
        // The internal map should be empty when no mappings are supplied.
        assertTrue("Mappings should be empty", context.getMappings().isEmpty());
    }

    @Test
    public void testApplyPrefixReplacesExistingPrefix() {
        context.applyPrefix("foo");
        // Use reflection to read the private nameBuilder field.
        String prefix = (String) getPrivateField(context, "nameBuilder").toString();
        assertEquals("foo", prefix);

        // Apply a second prefix – it must replace the previous one.
        context.applyPrefix("bar.baz");
        assertEquals("bar.baz", context.applyNamingStrategy(NamingStrategy.VERBATIM).toString());
    }

    @Test
    public void testApplyNamingStrategyAcceptsNullAndValidValues() {
        // Null must be ignored – the default is KEBAB_CASE.
        NamingStrategy before = (NamingStrategy) getPrivateField(context, "namingStrategy");
        context.applyNamingStrategy(null);
        NamingStrategy after = (NamingStrategy) getPrivateField(context, "namingStrategy");
        assertSame("Null naming strategy must be ignored", before, after);

        // Set a different strategy and verify the change.
        context.applyNamingStrategy(NamingStrategy.SNAKE_CASE);
        NamingStrategy changed = (NamingStrategy) getPrivateField(context, "namingStrategy");
        assertEquals(NamingStrategy.SNAKE_CASE, changed);
    }

    @Test
    public void testApplyBeanStyleGettersAcceptsNullAndTrue() {
        // Null is ignored.
        Boolean before = (Boolean) getPrivateField(context, "beanStyleGetters");
        context.applyBeanStyleGetters(null);
        Boolean after = (Boolean) getPrivateField(context, "beanStyleGetters");
        assertEquals(before, after);

        // Set to true and verify.
        context.applyBeanStyleGetters(Boolean.TRUE);
        Boolean changed = (Boolean) getPrivateField(context, "beanStyleGetters");
        assertTrue(changed);
    }

    @Test
    public void testProblemAddsProblemInstance() {
        RuntimeException ex = new RuntimeException("boom");
        context.problem(ex);
        List<Problem> problems = context.getProblems();
        assertEquals(1, problems.size());
        assertEquals("java.lang.RuntimeException: boom", problems.get(0).getMessage());
    }

    @Test
    public void testGetProblemsReturnsLiveList() {
        List<Problem> list = context.getProblems();
        assertTrue(list.isEmpty());

        // Adding via the public API must reflect in the returned list.
        context.problem(new IllegalArgumentException("oops"));
        assertEquals(1, list.size());
    }

    /* -------------------------------------------------------------
     *  Tests for the private getConverterInstance method (via reflection)
     * ------------------------------------------------------------- */

    @Test
    public void testGetConverterInstanceCreatesInstanceSuccessfully() throws Exception {
        // Use reflection to invoke the private method.
        Converter<?> conv = (Converter<?>) invokePrivate(context,
                "getConverterInstance",
                new Class[]{Class.class},
                new Object[]{SimpleStringConverter.class});
        assertNotNull(conv);
        assertTrue(conv instanceof SimpleStringConverter);
    }

    @Test(expected = InstantiationError.class)
    public void testGetConverterInstanceInstantiationError() throws Exception {
        // No default constructor – should trigger InstantiationError.
        invokePrivate(context,
                "getConverterInstance",
                new Class[]{Class.class},
                new Object[]{NoDefaultCtorConverter.class});
    }

    @Test(expected = IllegalAccessError.class)
    public void testGetConverterInstanceIllegalAccessError() throws Exception {
        // Private constructor – reflection will attempt to instantiate and fail with IllegalAccessError.
        // The NoDefaultCtorConverter already covers this path; however we also test a protected ctor.
        class ProtectedCtorConverter implements Converter<String> {
            protected ProtectedCtorConverter() {}
            @Override public String convert(String v) { return v; }
        }
        invokePrivate(context,
                "getConverterInstance",
                new Class[]{Class.class},
                new Object[]{ProtectedCtorConverter.class});
    }

    @Test(expected = UndeclaredThrowableException.class)
    public void testGetConverterInstanceInvocationTargetExceptionWrapped() throws Exception {
        // Constructor throws a checked exception – it must be wrapped.
        invokePrivate(context,
                "getConverterInstance",
                new Class[]{Class.class},
                new Object[]{BadConstructorConverter.class});
    }

    /* -------------------------------------------------------------
     *  Tests for ObjectCreator – a representative subset
     * ------------------------------------------------------------- */

    @Test
    public void testObjectCreatorValueRetrievesSimpleProperty() {
        // Set a system property that the config will read.
        System.setProperty("my.prop", "hello");

        ConfigMappingContext.ObjectCreator<String> creator =
                new ConfigMappingContext.ObjectCreator<>("my.prop");

        creator.value(String.class, null);
        String result = creator.get();
        assertEquals("hello", result);
    }

    @Test
    public void testObjectCreatorOptionalValueWhenMissingReturnsEmpty() {
        ConfigMappingContext.ObjectCreator<Integer> creator =
                new ConfigMappingContext.ObjectCreator<>("missing.prop");

        creator.optionalValue(Integer.class, null);
        Optional<Integer> opt = creator.get();
        assertFalse(opt.isPresent());
    }

    @Test
    public void testObjectCreatorCollectionCreatesList() {
        // Populate indexed properties: my.list[0]=a, my.list[1]=b
        System.setProperty("my.list[0]", "a");
        System.setProperty("my.list[1]", "b");

        ConfigMappingContext.ObjectCreator<List<String>> creator =
                new ConfigMappingContext.ObjectCreator<>("my.list");

        creator.collection(List.class);
        List<String> list = creator.get();
        assertEquals(Arrays.asList("a", "b"), list);
    }

    @Test
    public void testObjectCreatorMapWithDefaultValue() {
        // No explicit map entries – default value should be used.
        ConfigMappingContext.ObjectCreator<Map<String, String>> creator =
                new ConfigMappingContext.ObjectCreator<>("empty.map");

        creator.map(String.class, SimpleStringConverter.class, null, Collections.emptyList(), "default");
        Map<String, String> map = creator.get();
        // MapWithDefault returns the supplied default for any missing key.
        assertEquals("default", map.get("any"));
    }

    @Test
    public void testObjectCreatorGroupCreatesNestedGroup() {
        // Define a dummy nested interface.
        interface NestedGroup { String value(); }

        // Register a mapping for the nested group via a dummy ConfigClass.
        ConfigClass nestedClass = ConfigClass.configClass(NestedGroup.class, "nested");
        mappingBuilder.mapping(nestedClass);
        // Re‑create the context so the new mapping is taken into account.
        ConfigMappingContext ctx = new ConfigMappingContext(config, mappingBuilder);

        ConfigMappingContext.ObjectCreator<NestedGroup> creator =
                new ConfigMappingContext.ObjectCreator<>("nested");
        creator.group(NestedGroup.class);
        NestedGroup group = creator.get();
        assertNotNull(group);
    }

    /* -------------------------------------------------------------
     *  Helper methods for reflection access
     * ------------------------------------------------------------- */

    /** Retrieves a private field value via reflection. */
    private Object getPrivateField(Object target, String fieldName) {
        try {
            java.lang.reflect.Field f = target.getClass().getDeclaredField(fieldName);
            f.setAccessible(true);
            return f.get(target);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    /**
     * Invokes a private method via reflection.
     *
     * @param target   the object on which to invoke the method
     * @param name     method name
     * @param paramTypes array of parameter types
     * @param args     method arguments
     * @return the result of the method call
     */
    private Object invokePrivate(Object target, String name, Class<?>[] paramTypes, Object[] args) throws Exception {
        java.lang.reflect.Method m = target.getClass().getDeclaredMethod(name, paramTypes);
        m.setAccessible(true);
        return m.invoke(target, args);
    }
}
